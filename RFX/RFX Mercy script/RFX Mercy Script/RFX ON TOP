local SelectedTargetPlayer = nil
local ViewingTarget = false
local FlingingTarget = false

local function GetPlayerByShortcut(txt)
    txt = txt:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Name:lower():sub(1, #txt) == txt or p.DisplayName:lower():sub(1, #txt) == txt then
                return p
            end
        end
    end
    return nil
end

local function UpdateTargetInfo(p)
    if p and p ~= LocalPlayer then
        SelectedTargetPlayer = p
        vu261.Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=150&h=150"
        
        local joinDate = "N/A"
        pcall(function()
            local info = game:GetService("UserService"):GetUserInfosByUserIdsAsync({p.UserId})
            if info and info[1] then
                joinDate = "Yes"
            end
        end)
        
        pcall(function()
            local req = game:HttpGet("https://users.roblox.com/v1/users/" .. p.UserId)
            local data = game:GetService("HttpService"):JSONDecode(req)
            if data and data.created then
                joinDate = data.created:sub(1, 10)
            end
        end)

        vu264.Text = "UserID: " .. p.UserId .. "\nDisplay: " .. p.DisplayName .. "\nJoined: " .. joinDate
    else
        SelectedTargetPlayer = nil
        vu263.Text = ""
        vu261.Image = "rbxassetid://10818605405"
        vu264.Text = "UserID: \nDisplay: \nJoined: "
        if ViewingTarget then
            ViewingTarget = false
            Workspace.CurrentCamera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            vu265.Text = "المشاهدة"
        end
        FlingingTarget = false
        vu267.Text = "فلنق"
    end
end

vu263:GetPropertyChangedSignal("Text"):Connect(function()
    local txt = vu263.Text
    if txt == "" then
        UpdateTargetInfo(nil)
        return
    end
    
    local found = GetPlayerByShortcut(txt)
    if found then
        UpdateTargetInfo(found)
    else
        UpdateTargetInfo(nil)
        vu263.Text = ""
    end
end)

